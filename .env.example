# Copie para .env e preencha. O .env fica fora do Git.
# Chave gratuita em https://aistudio.google.com (botão "Get API key")
GEMINI_API_KEY=

# Opcional: outro modelo do Gemini
# GEMINI_MODELO=gemini-3.8-flash

# Opcional: preço em dólares por milhão de tokens, para o relatório mostrar o custo
# CUSTO_MILHAO_ENTRADA=
# CUSTO_MILHAO_SAIDA=
